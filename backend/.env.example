DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require
# Obligatoria: clave aleatoria de 32+ caracteres (el backend no arranca sin ella).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Pool de conexiones (opcional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- IA (resúmenes y esquemas) ---
# Proveedor: "groq" (por defecto, gratis) o "gemini".
IA_PROVIDER=groq
# Groq (crea una clave gratis en https://console.groq.com/keys)
GROQ_API_KEY=tu-api-key-de-groq
GROQ_MODEL=openai/gpt-oss-120b
# Gemini (solo si IA_PROVIDER=gemini)
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_HOSTED_DOMAIN=academiamega.net

# Roles: emails que se promocionan automáticamente al iniciar sesión (separados por comas)
ADMIN_EMAILS=director@academiamega.net
PROFESOR_EMAILS=profe1@academiamega.net,profe2@academiamega.net
# Alumnos de prueba que pueden entrar con contraseña (por defecto estudiante@academiamega.net)
CUENTAS_PRUEBA_EMAILS=estudiante@academiamega.net

# Monitorización de errores (opcional): si se define, se activa Sentry
SENTRY_DSN=

# Tamaño máximo por PDF de temario en MB (se guardan en la BD)
MAX_PDF_MB=10

# --- Seguridad y RGPD ---
# Orígenes extra que pueden llamar a la API (separados por comas). Por defecto solo
# https://mega-2-rho.vercel.app y localhost:5173. Añade aquí un dominio propio si lo usáis.
CORS_ORIGENES_EXTRA=
# Versión vigente de la política de privacidad. Si la cambias, todos tendrán que
# volver a aceptarla en su siguiente acceso.
VERSION_PRIVACIDAD=2026-11
